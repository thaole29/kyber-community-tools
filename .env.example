# Example environment file — copy to `.env` and fill in real values.
# `.env` is gitignored; NEVER commit real secrets. This file holds NO values.

# --- Discord / Telegram ---
DISCORD_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# TELEGRAM_CHAT_ID_2=

# --- Gemini (community digest + chatbot embeddings) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Chatbot: bring-your-own LLM (Section 3) ---
# provider: gemini | openai | anthropic   (openai = any OpenAI-compatible endpoint)
CHATBOT_LLM_PROVIDER=openai
# Base URL for openai-compatible / custom endpoints, e.g. http://host:8000/v1
CHATBOT_LLM_BASE_URL=
# The secret API key. Prefer adding it via:
#   read -rs -p "key: " K && printf '\nCHATBOT_LLM_API_KEY=%s\n' "$K" >> .env && unset K
CHATBOT_LLM_API_KEY=
CHATBOT_LLM_MODEL=
# Optional tuning:
# CHATBOT_LLM_MAX_TOKENS=1500
# CHATBOT_LLM_TEMPERATURE=0.2
# CHATBOT_EMBED_MODEL=gemini-embedding-001
# CHATBOT_PORT=8100
